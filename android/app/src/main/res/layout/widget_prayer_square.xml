<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_square_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <!-- Top Block: Label + Next Prayer Time + Big Countdown -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Normal Label (Accent) -->
        <TextView
            android:id="@+id/tv_square_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Asr in"
            android:textColor="@color/w_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <!-- Warm State Label (Warning Amber) -->
        <TextView
            android:id="@+id/tv_square_label_warm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Asr in"
            android:textColor="@color/w_warm_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:visibility="gone" />

        <!-- Next Prayer Clock Time (e.g. 3:06 PM) on top right -->
        <TextView
            android:id="@+id/tv_square_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="15:12"
            android:textColor="@color/w_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </RelativeLayout>

    <!-- Countdown Digits (Fixed-width tnum, always text_primary) -->
    <Chronometer
        android:id="@+id/tv_square_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/w_text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false" />

    <!-- Expanding Spacer -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Block: Progress Bar + Footer Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Normal Progress Bar (4dp) -->
        <ProgressBar
            android:id="@+id/pb_square_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="1000"
            android:progress="600"
            android:progressDrawable="@drawable/widget_progress_bar" />

        <!-- Warm State Progress Bar (4dp) -->
        <ProgressBar
            android:id="@+id/pb_square_progress_warm"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="1000"
            android:progress="600"
            android:progressDrawable="@drawable/widget_progress_bar_warm"
            android:visibility="gone" />

        <!-- Footer Row: Left = Footer Text (e.g. "Now: Dhuhr"), Right = Current Prayer Start Time (e.g. "11:43 AM") -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tv_square_footer_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Now: Dhuhr"
                android:textColor="@color/w_text_secondary"
                android:textSize="11sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_square_footer_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="11:47"
                android:textColor="@color/w_text_muted"
                android:textSize="11sp"
                android:includeFontPadding="false" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>
