<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_banner_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="inherit"
    android:textDirection="inherit"
    style="@style/WidgetCard">
    <LinearLayout
        android:id="@+id/widget_primary_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <LinearLayout
            android:id="@+id/widget_primary_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_banner_label"
                style="@style/WidgetText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start" />
            <TextView
                android:id="@+id/tv_banner_label_warm"
                style="@style/WidgetText.LabelWarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/tv_banner_countdown"
                style="@style/WidgetText.CountdownSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/w_gap_label" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_context_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:paddingStart="@dimen/w_gap_columns">
            <TextView
                android:id="@+id/tv_banner_footer_top"
                style="@style/WidgetText.Context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end" />
            <TextView
                android:id="@+id/tv_banner_footer_bottom"
                style="@style/WidgetText.Context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginTop="@dimen/w_gap_label" />
        </LinearLayout>
    </LinearLayout>
    <include layout="@layout/widget_progress" />
</LinearLayout>
