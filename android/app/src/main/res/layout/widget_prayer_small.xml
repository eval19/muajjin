<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp"
    android:gravity="center">

    <!-- Top Current Prayer Context Pill -->
    <TextView
        android:id="@+id/tv_prayer_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_status_badge"
        android:paddingStart="7dp"
        android:paddingTop="2dp"
        android:paddingEnd="7dp"
        android:paddingBottom="2dp"
        android:text="● Dhuhr 11:43 AM"
        android:textColor="#38BDF8"
        android:textSize="9sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Next Prayer (Hero Display) -->
    <TextView
        android:id="@+id/tv_prayer_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="NEXT SALAT"
        android:textColor="#64748B"
        android:textSize="8sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_prayer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Asr"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_prayer_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="03:06 PM"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:gravity="center" />

    <!-- Live Ticking Countdown Chronometer Badge -->
    <Chronometer
        android:id="@+id/tv_time_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_badge_background"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:textColor="#34D399"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Progress Line -->
    <ProgressBar
        android:id="@+id/pb_prayer_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="7dp"
        android:max="100"
        android:progress="60"
        android:progressDrawable="@drawable/widget_progress_drawable" />

</LinearLayout>
