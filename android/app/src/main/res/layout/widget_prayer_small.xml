<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp"
    android:gravity="center_horizontal">

    <!-- Top Current Prayer Context Pill (Vibrant Sky Blue #38BDF8) -->
    <TextView
        android:id="@+id/tv_prayer_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_status_badge"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:text="● Dhuhr · 11:43 AM"
        android:textColor="#38BDF8"
        android:textSize="10sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:gravity="center" />

    <!-- Expanding Spacer: Distributes space perfectly above hero -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Center Hero Group: Name, Time, and Live Countdown cohesive together -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Next Prayer Name (Hero) -->
        <TextView
            android:id="@+id/tv_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asr"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:gravity="center" />

        <!-- Next Prayer Scheduled Time -->
        <TextView
            android:id="@+id/tv_prayer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="03:06 PM"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:gravity="center" />

        <!-- Live Ticking Countdown Chronometer Badge -->
        <Chronometer
            android:id="@+id/tv_time_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_badge_background"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textColor="#34D399"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- Expanding Spacer: Distributes space perfectly below hero -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Progress Line -->
    <ProgressBar
        android:id="@+id/pb_prayer_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="60"
        android:progressDrawable="@drawable/widget_progress_drawable" />

</LinearLayout>
