<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="center_horizontal">

    <!-- Top Current Prayer Context Pill (Vibrant Sky Blue #38BDF8) -->
    <TextView
        android:id="@+id/tv_prayer_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_status_badge"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="● CURRENT: DHUHR · 11:43 AM"
        android:textColor="#38BDF8"
        android:textSize="10sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Expanding Spacer -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Next Prayer (Hero Display) -->
    <TextView
        android:id="@+id/tv_prayer_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEXT SALAT"
        android:textColor="#64748B"
        android:textSize="8sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_prayer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Asr"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_prayer_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="03:06 PM"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Expanding Spacer -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Live Ticking Countdown Chronometer Badge -->
    <Chronometer
        android:id="@+id/tv_time_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_badge_background"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="#34D399"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Progress Line -->
    <ProgressBar
        android:id="@+id/pb_prayer_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="60"
        android:progressDrawable="@drawable/widget_progress_drawable" />

</LinearLayout>
