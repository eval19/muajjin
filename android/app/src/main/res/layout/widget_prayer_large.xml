<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_large_root"
    android:layoutDirection="inherit"
    android:textDirection="inherit"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Top Metadata Header: Location · Hijri Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_large_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="RIYADH GOVERNORATE"
            android:textColor="@color/w_text_secondary"
            android:includeFontPadding="false"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_large_hijri"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="19 Rabi al-Thani 1448"
            android:textColor="@color/w_text_secondary"
            android:includeFontPadding="false"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Main Highlight: Current Context & Next Prayer Hero -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/tv_large_countdown"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_large_current_pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_status_badge"
                android:paddingStart="8dp"
                android:paddingTop="1dp"
                android:paddingEnd="8dp"
                android:paddingBottom="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="● CURRENT: DHUHR · 11:43 AM"
                android:textColor="#38BDF8"
                android:includeFontPadding="false"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_large_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Asr · 03:06 PM"
                android:textColor="@color/w_text_primary"
                android:includeFontPadding="false"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live Ticking Countdown Chronometer Badge -->
        <Chronometer
            android:id="@+id/tv_large_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_badge_background"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textColor="#34D399"
            android:includeFontPadding="false"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Progress Line -->
    <ProgressBar
        android:id="@+id/pb_large_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="3dp"
        android:max="100"
        android:progress="65"
        android:progressDrawable="@drawable/widget_progress_drawable" />

    <!-- Two rows retain all six prayers without clipping tall RTL glyphs at minimum height. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <RelativeLayout
                android:id="@+id/row_fajr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_name_fajr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="Fajr"
                    android:textColor="@color/w_text_primary"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_time_fajr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_name_fajr"
                    android:layout_alignParentStart="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="04:26 AM"
                    android:textColor="@color/w_text_secondary"
                    android:textSize="12sp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/row_sunrise"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_name_sunrise"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="Sunrise"
                    android:textColor="@color/w_text_secondary"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_time_sunrise"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_name_sunrise"
                    android:layout_alignParentStart="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="05:44 AM"
                    android:textColor="@color/w_text_secondary"
                    android:textSize="12sp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/row_dhuhr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_name_dhuhr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="Dhuhr"
                    android:textColor="@color/w_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_time_dhuhr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_name_dhuhr"
                    android:layout_alignParentStart="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="11:43 AM"
                    android:textColor="@color/w_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <RelativeLayout
                android:id="@+id/row_asr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_name_asr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="Asr"
                    android:textColor="@color/w_text_primary"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_time_asr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_name_asr"
                    android:layout_alignParentStart="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="03:06 PM"
                    android:textColor="@color/w_text_secondary"
                    android:textSize="12sp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/row_maghrib"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_name_maghrib"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="Maghrib"
                    android:textColor="@color/w_text_primary"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_time_maghrib"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_name_maghrib"
                    android:layout_alignParentStart="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="05:41 PM"
                    android:textColor="@color/w_text_secondary"
                    android:textSize="12sp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/row_isha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_name_isha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="Isha"
                    android:textColor="@color/w_text_primary"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_time_isha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_name_isha"
                    android:layout_alignParentStart="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="07:11 PM"
                    android:textColor="@color/w_text_secondary"
                    android:textSize="12sp" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
