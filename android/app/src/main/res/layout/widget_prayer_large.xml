<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_large_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_large_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="RIYADH GOVERNORATE"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_large_hijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="19 Rabi al-Thani 1448"
            android:textColor="#64748B"
            android:textSize="10sp" />
    </RelativeLayout>

    <!-- Current / Next Prayer Highlight -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_large_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_status_badge"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="NEXT SALAT"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_large_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Dhuhr · 11:43 AM"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_large_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_badge_background"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="in 1h 02m"
            android:textColor="#34D399"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/pb_large_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="65"
        android:progressDrawable="@drawable/widget_progress_drawable" />

    <!-- 5 Prayers List Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Fajr -->
        <RelativeLayout
            android:id="@+id/row_fajr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp">
            <TextView
                android:id="@+id/tv_name_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fajr"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="04:30 AM"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- Sunrise -->
        <RelativeLayout
            android:id="@+id/row_sunrise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp">
            <TextView
                android:id="@+id/tv_name_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sunrise"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_time_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="05:50 AM"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- Dhuhr -->
        <RelativeLayout
            android:id="@+id/row_dhuhr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp">
            <TextView
                android:id="@+id/tv_name_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dhuhr"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_time_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="12:15 PM"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- Asr -->
        <RelativeLayout
            android:id="@+id/row_asr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp">
            <TextView
                android:id="@+id/tv_name_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asr"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_time_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="03:45 PM"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- Maghrib -->
        <RelativeLayout
            android:id="@+id/row_maghrib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp">
            <TextView
                android:id="@+id/tv_name_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maghrib"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="06:14 PM"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- Isha -->
        <RelativeLayout
            android:id="@+id/row_isha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp">
            <TextView
                android:id="@+id/tv_name_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Isha"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_time_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="07:44 PM"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>
