<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_large_location"
            style="@style/WidgetText.MetadataBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_large_hijri"
            style="@style/WidgetText.Metadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/w_gap_label"
            android:gravity="start"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_primary_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/w_gap_label"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/widget_primary_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_large_label"
                style="@style/WidgetText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start" />

            <TextView
                android:id="@+id/tv_large_label_warm"
                style="@style/WidgetText.LabelWarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:visibility="gone" />

            <Chronometer
                android:id="@+id/tv_large_countdown"
                style="@style/WidgetText.CountdownTable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_context_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="@dimen/w_gap_columns"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_large_current_pill"
                style="@style/WidgetText.Context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textAlignment="viewEnd" />

            <TextView
                android:id="@+id/tv_large_summary"
                style="@style/WidgetText.Summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/w_gap_label"
                android:gravity="end"
                android:textAlignment="viewEnd" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
