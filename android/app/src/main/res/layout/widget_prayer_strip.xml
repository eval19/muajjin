<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_strip_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="inherit"
    android:textDirection="inherit"
    style="@style/WidgetCard"
    android:paddingStart="@dimen/w_compact_inset_horizontal"
    android:paddingEnd="@dimen/w_compact_inset_horizontal"
    android:paddingTop="@dimen/w_compact_inset_vertical"
    android:paddingBottom="@dimen/w_compact_inset_vertical">
    <LinearLayout
        android:id="@+id/widget_primary_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tv_strip_label"
            style="@style/WidgetText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start" />
        <TextView
            android:id="@+id/tv_strip_label_warm"
            style="@style/WidgetText.LabelWarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:visibility="gone" />
        <Chronometer
            android:id="@+id/tv_strip_countdown"
            style="@style/WidgetText.CountdownSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/w_gap_label" />
    </LinearLayout>
    <include layout="@layout/widget_progress" />
</LinearLayout>
