<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wide_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <!-- Top Row: Left Hero (Label + Countdown) & Right Context (2 Lines) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Left: Label & Big Countdown -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <!-- Normal Label (Accent) -->
            <TextView
                android:id="@+id/tv_wide_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asr in"
                android:textColor="@color/w_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />

            <!-- Warm State Label (Warning Amber) -->
            <TextView
                android:id="@+id/tv_wide_label_warm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asr in"
                android:textColor="@color/w_warm_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:visibility="gone" />

            <Chronometer
                android:id="@+id/tv_wide_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/w_text_primary"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Right: 2 Right-Aligned Context Lines -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_wide_footer_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Now: Dhuhr"
                android:textColor="@color/w_text_secondary"
                android:textSize="12sp"
                android:singleLine="true"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_wide_footer_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Asr at 3:06 PM"
                android:textColor="@color/w_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Normal Progress Bar (4dp) directly below hero section -->
    <ProgressBar
        android:id="@+id/pb_wide_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progress="600"
        android:progressDrawable="@drawable/widget_progress_bar" />

    <!-- Warm State Progress Bar (4dp) directly below hero section -->
    <ProgressBar
        android:id="@+id/pb_wide_progress_warm"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progress="600"
        android:progressDrawable="@drawable/widget_progress_bar_warm"
        android:visibility="gone" />

    <!-- Expanding Spacer between Hero zone and Bottom Chips zone -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom: Strip of Six Equal Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 1. Fajr Chip -->
        <LinearLayout
            android:id="@+id/chip_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/widget_chip_transparent">
            <TextView
                android:id="@+id/tv_chip_fajr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fajr"
                android:textColor="@color/w_text_secondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/tv_chip_fajr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="04:26"
                android:textColor="@color/w_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 2. Sunrise Chip -->
        <LinearLayout
            android:id="@+id/chip_sunrise"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/widget_chip_transparent">
            <TextView
                android:id="@+id/tv_chip_sunrise_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sunrise"
                android:textColor="@color/w_text_secondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/tv_chip_sunrise_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="05:44"
                android:textColor="@color/w_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 3. Dhuhr Chip -->
        <LinearLayout
            android:id="@+id/chip_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/widget_chip_current">
            <TextView
                android:id="@+id/tv_chip_dhuhr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dhuhr"
                android:textColor="@color/w_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/tv_chip_dhuhr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="11:43"
                android:textColor="@color/w_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 4. Asr Chip -->
        <LinearLayout
            android:id="@+id/chip_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/widget_chip_next">
            <TextView
                android:id="@+id/tv_chip_asr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asr"
                android:textColor="@color/w_text_secondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/tv_chip_asr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="03:06"
                android:textColor="@color/w_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 5. Maghrib Chip -->
        <LinearLayout
            android:id="@+id/chip_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/widget_chip_transparent">
            <TextView
                android:id="@+id/tv_chip_maghrib_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maghrib"
                android:textColor="@color/w_text_secondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/tv_chip_maghrib_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="05:41"
                android:textColor="@color/w_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 6. Isha Chip -->
        <LinearLayout
            android:id="@+id/chip_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/widget_chip_transparent">
            <TextView
                android:id="@+id/tv_chip_isha_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Isha"
                android:textColor="@color/w_text_secondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/tv_chip_isha_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="07:11"
                android:textColor="@color/w_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
