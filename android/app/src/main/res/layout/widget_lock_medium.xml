<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lock_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Left Block: Hero (Current, Label, Big Countdown) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="start">

        <TextView
            android:id="@+id/tv_lock_med_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asr in"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:includeFontPadding="false" />

        <Chronometer
            android:id="@+id/tv_lock_med_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Right Block: Context (Now: Current, Next Time) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tv_lock_med_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Now: Dhuhr"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tv_lock_med_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Asr at 15:12"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:includeFontPadding="false" />
    </LinearLayout>

</LinearLayout>
