<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lock_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="inherit"
    android:textDirection="inherit"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/w_compact_inset_horizontal"
    android:paddingEnd="@dimen/w_compact_inset_horizontal"
    android:paddingTop="@dimen/w_compact_inset_vertical"
    android:paddingBottom="@dimen/w_compact_inset_vertical">
    <LinearLayout
        android:id="@+id/widget_primary_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/tv_lock_small_label"
            style="@style/WidgetText.LockLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center" />
        <Chronometer
            android:id="@+id/tv_lock_small_countdown"
            style="@style/WidgetText.LockCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/w_gap_label"
            android:layout_gravity="center_horizontal" />
        <TextView
            android:id="@+id/tv_lock_small_time"
            style="@style/WidgetText.Lock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:fontFeatureSettings="tnum"
            android:layout_marginTop="@dimen/w_gap_label" />
    </LinearLayout>
</LinearLayout>
